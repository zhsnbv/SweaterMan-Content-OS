# ─────────────────────────────────────────────────────────────────────────────
# Sweater Man Content OS
#
# Every variable here is OPTIONAL. With an empty .env the app still boots and
# is fully usable: it falls back to a local file store, a local snapshot folder
# and a deterministic planning engine, and Settings tells you what is missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Without these the app uses a JSON file store under .localdata/ (single
# machine, no auth). With them: Postgres + Storage + Auth for the whole team.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider ─────────────────────────────────────────────────────────────
# anthropic | openai | mock
# "mock" (or a missing key) runs the deterministic engine: week planning,
# weekly review and card edits still work; free-form copy and reading
# analytics screenshots do not.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Three roles, so you can pay for depth only where it matters.
# Leave blank to use the provider's default for each role.
#   planner — routine work: week generation, card edits
#   review  — deeper analysis: weekly review
#   vision  — reading analytics screenshots (must be vision-capable)
AI_MODEL_PLANNER=
AI_MODEL_REVIEW=
AI_MODEL_VISION=

# ── GitHub durable state ────────────────────────────────────────────────────
# Content state is committed to a SEPARATE branch so content commits never
# trigger a deployment of main. The branch is created automatically at setup.
# Token needs: repo contents read/write on this repository only.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DATA_BRANCH=content-state

# Force the local snapshot folder even when a token exists (used by tests).
# GITHUB_SYNC=local

# ── Local development ───────────────────────────────────────────────────────
# Where the file store and local snapshot live when Supabase/GitHub are absent.
CONTENT_OS_DATA_DIR=.localdata/dev
# Display name for the single local user before Supabase Auth is connected.
CONTENT_OS_DEV_USER=Owner
